{
  "name": "panfolio",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm images:build && vite --host 0.0.0.0",
    "build": "pnpm images:build && tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "eval": "tsx scripts/eval.ts",
    "typecheck": "tsc --noEmit",
    "test:webkit": "playwright test --project=webkit",
    "format": "prettier --write src tests scripts *.ts *.json *.html *.md .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts *.ts *.json *.html *.md .github/workflows/*.yml",
    "images:build": "tsx scripts/recipe-images.ts",
    "eval:report": "tsx scripts/eval.ts --report"
  },
  "dependencies": {
    "@octopusgarage/s": "https://github.com/OctopusGarage/s/releases/download/sdk-v1.0.0/octopusgarage-s-1.0.0.tgz",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsqr": "^1.4.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
